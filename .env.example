# Copy to .env.local for the web app and to .env for the daily job.
# Never commit a file with real values. Vercel and GitHub Actions hold the
# production values as project secrets.

# --- Supabase (database + Google sign-in) -------------------------------
# From Supabase: Project Settings > API Keys. The publishable key
# (sb_publishable_...) is safe in the browser; the legacy "anon" key also works
# as NEXT_PUBLIC_SUPABASE_ANON_KEY, but Supabase retires it by the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...), for the daily job and seed scripts.
# Bypasses Row Level Security. Never in the web app, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Who may sign in during the beta (comma-separated emails) -----------
ALLOWED_EMAILS=you@example.com
# Stay signed in, but not forever: sign out after this many days since
# sign-in, or this many days without using the app.
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_DAYS=7

# --- Model provider for summaries and bias flags -------------------------
# The app talks to models through one interface (Vercel AI SDK), so switching
# provider is a config change, not a code change. Set the provider and model,
# then the matching key below. Only one key is required.
#
# Recommended: the Vercel AI Gateway ($5/month free credit, no markup, any
# model by name). LLM_MODEL is then "provider/model", for example
# anthropic/claude-haiku-5-5, google/gemini-3.1-flash-lite, groq/openai/gpt-oss-20b.
LLM_PROVIDER=gateway
LLM_MODEL=anthropic/claude-haiku-5-5
AI_GATEWAY_API_KEY=
# Direct providers, if you'd rather hold your own key:
# LLM_PROVIDER=google      LLM_MODEL=gemini-3.1-flash-lite
# GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_PROVIDER=anthropic   LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=groq        LLM_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# LLM_PROVIDER=openai      LLM_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=
# LLM_PROVIDER=mistral     LLM_MODEL=mistral-small-latest
# MISTRAL_API_KEY=

# Tests and local development use the fake provider, which replays recorded
# fixtures and never spends money:
# LLM_PROVIDER=fake

# --- Local development without any account ------------------------------
# `npm run dev:demo` sets this: the screens run on the seed files with sample
# candidates and no sign-in. Ignored by production builds.
# NEWSLY_DEMO=1

# --- Daily job --------------------------------------------------------------
# How far back each run looks for new articles.
NEWS_LOOKBACK_HOURS=36
# Kill switches: the run stops cleanly at either limit and keeps yesterday's data.
MAX_MODEL_CALLS_PER_RUN=200
MAX_RUN_COST_USD=1.00
# Where the "today" boundary falls for digests.
TZ=America/Los_Angeles
