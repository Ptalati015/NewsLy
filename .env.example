# Copy to .env.local for the web app and to .env for the daily job.
# Never commit a file with real values. Vercel and GitHub Actions hold the
# production values as project secrets.

# --- Supabase (database + Google sign-in) -------------------------------
# From Supabase: Project Settings > API Keys. The publishable key
# (sb_publishable_...) is safe in the browser; the legacy "anon" key also works
# as NEXT_PUBLIC_SUPABASE_ANON_KEY, but Supabase retires it by the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...), for the daily job and seed scripts.
# Bypasses Row Level Security. Never in the web app, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Who may sign in during the beta (comma-separated emails) -----------
# The app checks this list on every request. The database keeps the same list
# in the allowed_emails table (add each email there too, see docs/setup.md),
# and Row Level Security checks it (is_allowed()), so the list guards the
# data, not only the pages.
ALLOWED_EMAILS=you@example.com
# Stay signed in, but not forever: sign out after this many days since
# sign-in, or this many days without using the app.
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_DAYS=7

# --- Model provider for summaries and bias flags -------------------------
# The app talks to models through one interface (Vercel AI SDK), so switching
# provider is a config change, not a code change.
#
# Local development and tests use the fake provider: it answers every call with
# a deterministic, schema-valid response built from the input and never spends
# money. The daily job refuses it unless run with --dry-run or against a local
# database URL, so fake flags can never be stored as real ones.
LLM_PROVIDER=fake
#
# Production (daily.yml in GitHub Actions) sets LLM_PROVIDER=gateway. The
# Vercel AI Gateway ($5/month free credit, no markup) takes any model by name
# as "provider/model", for example anthropic/claude-haiku-5-5,
# google/gemini-3.1-flash-lite, groq/openai/gpt-oss-20b.
# LLM_PROVIDER=gateway
LLM_MODEL=anthropic/claude-haiku-5-5
# Two gateway keys exist, each with its own per-key budget set in the gateway:
# one for the daily job, one for live tests. Both live only in GitHub Actions
# secrets; daily.yml and live.yml each map theirs into this variable. Never set
# a model key in Vercel: the web app never calls a model.
AI_GATEWAY_API_KEY=
# Direct providers, if you'd rather hold your own key:
# LLM_PROVIDER=google      LLM_MODEL=gemini-3.1-flash-lite
# GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_PROVIDER=anthropic   LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=groq        LLM_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# LLM_PROVIDER=openai      LLM_MODEL=gpt-5.4-nano
# OPENAI_API_KEY=
# LLM_PROVIDER=mistral     LLM_MODEL=mistral-small-latest
# MISTRAL_API_KEY=

# --- Local development without any account ------------------------------
# `npm run dev:demo` sets this: the screens run on the seed files with sample
# candidates and no sign-in. Ignored by production builds.
# NEWSLY_DEMO=1

# --- Daily job --------------------------------------------------------------
# How far back each run looks for new articles.
NEWS_LOOKBACK_HOURS=36
# Kill switches: the run stops cleanly at either limit and keeps yesterday's
# data. A normal day costs about $0.06, so 0.25 is about four normal days.
MAX_MODEL_CALLS_PER_RUN=200
MAX_RUN_COST_USD=0.25
# Where the "today" boundary falls for digests.
TZ=America/Los_Angeles
